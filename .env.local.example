NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional for sending emails
RESEND_API_KEY=your_resend_api_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: same value in both — reduces casual abuse of POST /api/chat (embed loads token in browser; treat as obfuscation, not bank-grade secrecy)
WIDGET_EMBED_TOKEN=
NEXT_PUBLIC_WIDGET_EMBED_TOKEN=

# Comma-separated hostnames allowed to invoke Server Actions (no https://), e.g. myapp.vercel.app
SERVER_ACTIONS_ALLOWED_ORIGINS=localhost:3000
